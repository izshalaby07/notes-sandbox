{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/appsettings.Local.json)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh pr merge *)",
      "Bash(az deployment *)",
      "Bash(terraform apply *)",
      "Bash(kubectl apply *)"
    ],
    "ask": [
      "Bash(dotnet add * package *)",
      "Bash(npm install *)",
      "Bash(npm i *)"
    ]
  }
}
